# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="mysql://user:password@localhost:3306/citas_dev"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=citas-attachments

# Email
AWS_SES_FROM_EMAIL=noreply@citas.com

# Frontend
FRONTEND_URL=http://localhost:8081

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Firebase (Google Sign-In via Firebase)
# Firebase project id, used to validate the `aud` claim of Firebase ID tokens.
FIREBASE_PROJECT_ID=citas-e86bb

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Google Workspace integration (Calendar / Meet / Contacts)
# Redirect del flujo de "conectar" cuenta de Google del emprendedor (distinto del login).
GOOGLE_CONNECT_REDIRECT_URI=http://localhost:3000/api/v1/me/google/callback
# Clave para cifrar en reposo los tokens de Google (AES-256-GCM).
# Debe representar 32 bytes en base64 o hex. Genera una con:
#   openssl rand -base64 32
GOOGLE_TOKEN_ENC_KEY=generate-with-openssl-rand-base64-32

# Apple OAuth
APPLE_CLIENT_ID=com.yourapp.service
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivatekeyHere\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://yourapp.com/callback

# SuperAdmin seed (used by `npm run seed:superadmin`)
SUPERADMIN_EMAIL=xcode.arturo@gmail.com
SUPERADMIN_PASSWORD=change-me-before-seeding

# Mercado Pago (suscripciones recurrentes via API preapproval)
# Access Token de Mercado Pago. SIEMPRE se lee del entorno; si falta, los
# endpoints de creacion responden 503 (PAYMENTS_NOT_CONFIGURED). Nunca commitear
# un token real.
MERCADOPAGO_ACCESS_TOKEN=
# Precio mensual de la suscripcion en MXN (default 299 si no se define).
SUBSCRIPTION_PRICE_MXN=299
# URL de retorno del frontend tras autorizar el pago en Mercado Pago.
SUBSCRIPTION_BACK_URL=http://localhost:5173/suscripcion/retorno
# SOLO PRUEBAS (sandbox): fuerza el payer_email a un test_user comprador de la
# misma cuenta padre que el Access Token de prueba. En produccion NO definir.
MERCADOPAGO_TEST_PAYER_EMAIL=
# Dias de prueba (trial) al crear un negocio nuevo (default 30).
TRIAL_DAYS=30
