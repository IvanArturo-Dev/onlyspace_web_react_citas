# =============================================================================
# prod.env.example - Plantilla de secretos de PRODUCCION de OnlySpace para SSM.
# =============================================================================
#
# Este archivo (.example) SI se versiona: solo contiene placeholders, NO secretos.
#
# Uso:
#   1. Copialo a scripts/secrets/prod.env  (ese SI es secreto y NO se versiona).
#        cp scripts/secrets/prod.env.example scripts/secrets/prod.env
#   2. Rellena cada valor con el secreto REAL de produccion.
#   3. Ejecuta el cargador:  ./scripts/load-secrets-to-ssm.sh
#
# Formato: KEY=VALUE (una por linea, SIN comillas).
#   - Las lineas vacias y las que empiezan con '#' se ignoran.
#   - El VALUE puede contener '=' (p. ej. en una URL de conexion); solo se
#     separa por el PRIMER '='.
#
# IMPORTANTE:
#   - Estas claves van a AWS SSM Parameter Store (SecureString) bajo /onlyspace/.
#   - Las variables VITE_* del frontend NO van aqui: van a GitHub Secrets porque
#     se incrustan en el bundle publico y no son secretas.
# =============================================================================

# --- Entorno ---
NODE_ENV=production

# --- Base de datos (URL de conexion usada por Prisma/backend) ---
# Ejemplo de forma (NO uses este valor): mysql://user:pass@mysql:3306/dbname
DATABASE_URL=

# --- Redis ---
# Ejemplo de forma: redis://redis:6379
REDIS_URL=

# --- Autenticacion / JWT ---
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Mercado Pago (usar credenciales de PRODUCCION) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# --- Suscripcion ---
SUBSCRIPTION_PRICE_MXN=
SUBSCRIPTION_BACK_URL=
TRIAL_DAYS=

# --- Google OAuth / Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CONNECT_REDIRECT_URI=
GOOGLE_TOKEN_ENC_KEY=

# --- Firebase ---
FIREBASE_PROJECT_ID=

# --- Superadmin (semilla inicial) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Frontend ---
FRONTEND_URL=

# --- MySQL (contenedor de la base de datos en produccion) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
